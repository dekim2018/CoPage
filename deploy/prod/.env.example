# deploy/prod/compose.yaml 의 값 (docs/DEPLOY.md). .env 로 복사해 채운다. .env 는 저장소에 올리지 않는다.

# 화면과 API 를 내줄 도메인. DNS 의 A 레코드가 이 서버를 가리켜야 Caddy 가 인증서를 받는다.
COPAGE_DOMAIN=copage.example.com

# 무작위로 만든다. 예: openssl rand -base64 48
COPAGE_DB_PASSWORD=
COPAGE_JWT_SECRET=

# 선택. 에러 모니터링(Sentry 나 같은 규약의 GlitchTip). 서버와 화면에 따로 프로젝트를 만든다. 비우면 끈다.
# COPAGE_SENTRY_DSN=https://공개키@o0.ingest.sentry.io/서버프로젝트
# COPAGE_SENTRY_DSN_WEB=https://공개키@o0.ingest.sentry.io/화면프로젝트

# 선택. 서버 힙. 4GB 서버 기준 1GB.
# COPAGE_JAVA_OPTIONS=-Xmx1g
