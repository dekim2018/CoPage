{
  "name": "copage-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf": "vitest run -c vitest.perf.config.ts",
    "errdeck:sync": "cd ../../ErrDeck/sdk-vue && npm run build && cd - && cp ../../ErrDeck/sdk-vue/dist/*.js ../../ErrDeck/sdk-vue/dist/*.d.ts src/monitoring/errdeck-sdk/ && echo \"export * from './index'\" > src/monitoring/errdeck-sdk/errdeck-vue.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@sentry/vue": "^11.17.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bold": "3.35.0",
    "@tiptap/extension-code": "3.35.0",
    "@tiptap/extension-document": "3.35.0",
    "@tiptap/extension-italic": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-paragraph": "3.35.0",
    "@tiptap/extension-strike": "3.35.0",
    "@tiptap/extension-text": "3.35.0",
    "@tiptap/extension-underline": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/vue-3": "3.35.0",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  }
}
